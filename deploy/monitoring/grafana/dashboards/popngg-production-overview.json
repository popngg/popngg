      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"$job\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "all"}]
    },
    {
      "type": "timeseries", "title": "Average latency over time", "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "targets": [{"refId": "A", "expr": "1000 * sum(rate(http_server_requests_seconds_sum{job=\"$job\",uri!~\"/actuator.*\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"$job\",uri!~\"/actuator.*\"}[$__rate_interval])), 1e-9)", "legendFormat": "average"}]
    },
    {
      "type": "timeseries", "title": "P95 / P99 latency over time", "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "targets": [
        {"refId": "A", "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"$job\",uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "P95"},
        {"refId": "B", "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"$job\",uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "P99"}
      ]
    },
    {
      "type": "timeseries", "title": "HTTP status distribution", "id": 9,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"$job\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{status}}"}]
    },
    {
      "type": "table", "title": "Endpoint Performance", "id": 10,
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [
        {"refId": "Requests", "expr": "sum by (uri) (increase(http_server_requests_seconds_count{job=\"$job\",uri!~\"/actuator.*\"}[$__range]))", "format": "table", "instant": true},
        {"refId": "Avg_ms", "expr": "1000 * sum by (uri) (rate(http_server_requests_seconds_sum{job=\"$job\",uri!~\"/actuator.*\"}[$__rate_interval])) / clamp_min(sum by (uri) (rate(http_server_requests_seconds_count{job=\"$job\",uri!~\"/actuator.*\"}[$__rate_interval])), 1e-9)", "format": "table", "instant": true},
        {"refId": "P95_ms", "expr": "1000 * histogram_quantile(0.95, sum by (uri, le) (rate(http_server_requests_seconds_bucket{job=\"$job\",uri!~\"/actuator.*\"}[$__rate_interval])))", "format": "table", "instant": true},
        {"refId": "P99_ms", "expr": "1000 * histogram_quantile(0.99, sum by (uri, le) (rate(http_server_requests_seconds_bucket{job=\"$job\",uri!~\"/actuator.*\"}[$__rate_interval])))", "format": "table", "instant": true},
        {"refId": "4xx", "expr": "sum by (uri) (increase(http_server_requests_seconds_count{job=\"$job\",uri!~\"/actuator.*\",status=~\"4..\"}[$__range]))", "format": "table", "instant": true},
        {"refId": "5xx", "expr": "sum by (uri) (increase(http_server_requests_seconds_count{job=\"$job\",uri!~\"/actuator.*\",status=~\"5..\"}[$__range]))", "format": "table", "instant": true}
      ],
      "transformations": [
        {"id": "joinByField", "options": {"byField": "uri", "mode": "outer"}},
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {"uri": 0, "Value #Requests": 1, "Value #Avg_ms": 2, "Value #P95_ms": 3, "Value #P99_ms": 4, "Value #4xx": 5, "Value #5xx": 6}, "renameByName": {"uri": "Endpoint", "Value #Requests": "Requests", "Value #Avg_ms": "Avg (ms)", "Value #P95_ms": "P95 (ms)", "Value #P99_ms": "P99 (ms)", "Value #4xx": "4xx", "Value #5xx": "5xx"}}}
      ]
    },
