# Copy to .env only when using deploy/compose.yml. Never commit the copied file.
IMAGE_REPOSITORY=popngg-api
IMAGE_TAG=replace-with-a-commit-sha-or-release-tag
DB_PASSWORD=replace-me
DB_ROOT_PASSWORD=replace-me
# Generate at least 64 random characters. Never reuse the local development key.
JWT_SECRET_KEY=replace-with-at-least-64-random-characters
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=popngg
# Set false only for temporary HTTP development servers. Use true with HTTPS.
AUTH_COOKIE_SECURE=true
# Use Lax for popn.gg. Set None only when a cross-site development frontend must authenticate.
AUTH_COOKIE_SAME_SITE=Lax
# Swagger UI and OpenAPI JSON use HTTP Basic authentication.
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=replace-with-a-unique-random-password
# Trust Nginx's X-Forwarded-* headers so Spring sees the original HTTPS request.
SERVER_FORWARD_HEADERS_STRATEGY=framework
API_PORT=8080
# Comma-separated frontend origins. Do not add a trailing slash.
CORS_ALLOWED_ORIGINS=https://popn.gg
# Public API URL used by deployment smoke tests after Nginx/Let's Encrypt setup.
BASE_URL=https://api.popn.gg
GAME_CURRENT_VERSION=29
RENEWAL_COLLECTOR_VERSION=1
RENEWAL_GAME=popn29
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_ADMIN_WEBHOOK_URL=
DISCORD_ERROR_WEBHOOK_URL=
# GitHub Actions repository secret. The API container does not consume this value.
DISCORD_PR_WEBHOOK_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_JACKET_PREFIX=static
AWS_S3_AVATAR_PREFIX=avatars
AWS_CLOUDFRONT_URL=https://static.popn.gg
SERVER_MAX_SWALLOW_SIZE=4MB
# Optional tools and smoke-test settings
ADMINER_PORT=8081
# Monitoring ports bind to loopback only. Use an SSH tunnel for remote access.
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_DOMAIN=grafana.popn.gg
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-random-password
# SMOKE_POPTOMO_ID=0000-0000-0000
# SMOKE_LOGIN_PASSWORD=64-character-sha256-value
